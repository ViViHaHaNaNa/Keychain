# Password for the control page
APP_PASSWORD=change-me
# Long random string used to sign the login cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Secret the ESP32 sends as /api/state?key=...
DEVICE_KEY=
# Spotify app (developer.spotify.com/dashboard); redirect URI: https://<your-domain>/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Upstash Redis (Vercel's Upstash integration may name these KV_REST_API_URL / KV_REST_API_TOKEN; both work)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
